package p10;

import java.util.Scanner;

public class MainEj1 {

	public static void main(String[] args) {
		Scanner read = new Scanner(System.in);
		Poligono com;
		double b, h, r;
		int op;
		
		System.out.println("Ingrese el número de la figura a la que le quiere scar el área:");
		System.out.println("1) Círculo");
		System.out.println("2) Triángulo");
		System.out.println("3) Salir");
		op=read.nextInt();
		do {
			switch(op) {
			case 1:
				System.out.println("Ingrese el radio del circulo");
				r=read.nextDouble();
				com = new Circulo(r);
				System.out.println("El área es: " + com.calcularArea());
				System.out.println("¿Quiere calcular otra área (Triangulo o Circulo)?, 3 si no quiere");
				op=read.nextInt();
				break;
			case 2:
				System.out.println("Ingrese la base del triángulo");
				b=read.nextDouble();
				System.out.println("Ingrese la altura del triángulo");
				h=read.nextDouble();
				com = new Triangulo(b , h);
				System.out.println("El área es: " + com.calcularArea());
				System.out.println("¿Quiere calcular otra área (Triangulo o Circulo)?, 3 si no quiere");
				op=read.nextInt();
				break;
			case 3:
				break;
			default:
				System.out.println("Opción inválida ingrese otra");
				op=read.nextInt();
				break;
			}
		}while(op!=3);
		System.out.println("Saliendo del sistema");
		
		read.close();
	}

}
